{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "PRIVILEGE_ESCALATION",
              "shortDescription": {
                "text": "Docker socket 挂载导致容器逃逸与主机权限提升"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "AUTH_BYPASS",
              "shortDescription": {
                "text": "underscores_in_headers 导致的访问控制绕过"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "INFORMATION_DISCLOSURE",
              "shortDescription": {
                "text": "/admin/key 路由未授权访问导致敏感密钥泄露"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PRIVILEGE_ESCALATION",
          "level": "error",
          "message": {
            "text": "Docker socket 挂载导致容器逃逸与主机权限提升"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docker-compose.yml"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTH_BYPASS",
          "level": "error",
          "message": {
            "text": "underscores_in_headers 导致的访问控制绕过"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/setup.sh"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "INFORMATION_DISCLOSURE",
          "level": "error",
          "message": {
            "text": "/admin/key 路由未授权访问导致敏感密钥泄露"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/server.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}