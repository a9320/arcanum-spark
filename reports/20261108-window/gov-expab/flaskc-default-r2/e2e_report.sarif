{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "DESERIALIZATION",
              "shortDescription": {
                "text": "Redis 缓存投毒导致 Flask-Caching 反序列化 RCE"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DESERIALIZATION",
          "level": "error",
          "message": {
            "text": "app.py:32-43 证实了接口未对 `title` 进行任何过滤逻辑；README.md:22, 25, 28, 30 证实了 Flask-Caching 使用 pickle 存储数据且仅对以 '!' 开头的缓存值进行反序列化。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 24,
                  "snippet": {
                    "text": "title = request.form.get('title', default=None)\ncontent = request.files.get('content', default=None)\n...\nredis.setex(name=title, value=content, time=3)"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}