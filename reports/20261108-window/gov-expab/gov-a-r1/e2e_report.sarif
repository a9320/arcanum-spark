{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "PRIVILEGE_ESCALATION",
              "shortDescription": {
                "text": "Docker socket 挂载导致容器逃逸与主机权限提升"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "AUTH_BYPASS",
              "shortDescription": {
                "text": "underscores_in_headers + gunicorn SCRIPT_NAME 头部注入绕过 nginx /admin 拒绝"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "INFORMATION_DISCLOSURE",
              "shortDescription": {
                "text": "/admin/key 未授权密钥泄露"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PRIVILEGE_ESCALATION",
          "level": "error",
          "message": {
            "text": "docker-compose.yml:5: - /var/run/docker.sock:/var/run/docker.sock"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docker-compose.yml"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "AUTH_BYPASS",
          "level": "error",
          "message": {
            "text": "server/setup.sh:18: underscores_in_headers on; server/setup.sh:26: proxy_pass_request_headers on; server/setup.sh:35: location ^~ /admin/ { deny all; }"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/setup.sh"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "INFORMATION_DISCLOSURE",
          "level": "error",
          "message": {
            "text": "server/server.py:52: @app.route('/admin/key')\nserver/server.py:53: def get_key():\nserver/server.py:54:     return jsonify(key=get_info()['key'])"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/server.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}