{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "DESERIALIZATION",
              "shortDescription": {
                "text": "Redis 缓存投毒导致 Flask-Caching 反序列化 RCE"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "CACHE_POISONING",
              "shortDescription": {
                "text": "笔记接口允许任意 Redis 键覆盖，绕过预期过滤"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DESERIALIZATION",
          "level": "error",
          "message": {
            "text": "README.md 证实 Flask-Caching 使用 pickle 序列化响应，且仅当值以 `!` 开头时才进行反序列化；同时证实缓存键的生成格式为 `flask_cache_view//testX`。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 33,
                  "snippet": {
                    "text": "redis.setex(name=title, value=content, time=3)"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CACHE_POISONING",
          "level": "error",
          "message": {
            "text": "`app.py` 代码（第 32-43 行）显示，`title` 直接从 `request.form` 获取后被直接用于 `redis.setex` 的键名，中间没有任何针对 `flask_cache_view//` 等模式的过滤或替换逻辑。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 24,
                  "snippet": {
                    "text": "title = request.form.get('title', default=None)\ncontent = request.files.get('content', default=None)\n...\nredis.setex(name=title, value=content, time=3)"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}