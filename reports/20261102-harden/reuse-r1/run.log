15 cat > /etc/nginx/sites-enabled/default <<"EOF"
16 server {
17     listen 80;
18
19     underscores_in_headers on;
20
21     location / {
22         include proxy_params;
23
24         # Nginx uses the WSGI protocol to transmit the request to gunicorn through the domain socket 
25         # We do this so the network can't connect to gunicorn directly, only though nginx
26         proxy_pass http://unix:/tmp/gunicorn.sock;
27         proxy_pass_request_headers on;
28
29         # INFO(brad)
30         # Thought I would explain this to clear it up:
31         # When we make a request, nginx forwards the request to gunicorn.
32         # Gunicorn then reads the request and calculates the path (which is put into the WSGI variable `path_info`)
33         #
34         # We can prevent nginx from forwarding any request starting with "/admin/". If we do this 
35         # there is no way for gunicorn to send flask a `path_info` which starts with "/admin/"
36         # Thus any flask route starting with /admin/ should be safe :)
37         location ^~ /admin/ {
38             deny all;
39         }
40     }
41 }
42
43 EOF

