      "tool": {
        "driver": {
          "name": "CodeRisk Arcana",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "PIT-T-46",
              "shortDescription": {
                "text": "[PIT-T-46] .cursor/rules 指令覆盖后门（Ignore all previous instructions）"
              },
