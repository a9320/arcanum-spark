                "cwe": "",
                "severity": "critical"
              }
            },
            {
              "id": "PIT-N-06",
              "shortDescription": {
                "text": "[PIT-N-06] docs/AGENT_GUIDE.md 文档投毒（ignore all previous instructions + .env 外泄指令）"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-54",
              "shortDescription": {
                "text": "[PIT-E-54] src/admin_panel.py Trojan Source 双向字符欺骗"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-57",
              "shortDescription": {
                "text": "[PIT-E-57] src/config.py 双重 base64 编码注入载荷"
