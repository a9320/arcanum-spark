                "cwe": "",
                "severity": "critical"
              }
            },
            {
              "id": "PIT-E-23",
              "shortDescription": {
                "text": "[PIT-E-23] src/rewards.py 第 2 行零宽空格走私"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "PIT-T-51",
              "shortDescription": {
