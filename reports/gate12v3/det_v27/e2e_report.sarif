{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "PIT-T-46",
              "shortDescription": {
                "text": "[PIT-T-46] Agent Instruction-File Injection"
              },
              "properties": {
                "cwe": "CWE-77",
                "severity": "critical"
              }
            },
            {
              "id": "PIT-N-06",
              "shortDescription": {
                "text": "[PIT-N-06] Document / File Upload"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-57",
              "shortDescription": {
                "text": "[PIT-E-57] Layered Encoding"
              },
              "properties": {
                "cwe": null,
                "severity": "critical"
              }
            },
            {
              "id": "PIT-E-23",
              "shortDescription": {
                "text": "[PIT-E-23] Invisible Text"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-T-51",
              "shortDescription": {
                "text": "[PIT-T-51] Instruction Override"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-54",
              "shortDescription": {
                "text": "[PIT-E-54] Trojan Source"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "AI_PROMPT_INJECTION_CHAIN",
              "shortDescription": {
                "text": "Coordinated multi-file AI prompt injection exfiltration campaign"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "COMMAND_INJECTION",
              "shortDescription": {
                "text": "Command injection via shell=True in ping_host"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "WEAK_CRYPTOGRAPHY",
              "shortDescription": {
                "text": "Weak password hashing without salt"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "LOGIC_ERROR",
              "shortDescription": {
                "text": "Logic flaw / infinite recursion amplified by Trojan Source visual spoofing"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PIT-T-46",
          "level": "warning",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/copilot-instructions.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "Ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-T-46",
          "level": "warning",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "AGENTS.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "Ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-N-06",
          "level": "error",
          "message": {
            "text": "项目文档中检测到面向 AI Agent 的指令注入模式（ignore all previous instructions，共 1 行出现）。文档是 Agent 的常规输入，投毒不会被人类评审与传统工具注意。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/AGENT_GUIDE.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-57",
          "level": "warning",
          "message": {
            "text": "检测到2层编码（base64→base64）的提示注入载荷，用于规避基于关键词的过滤。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/constants.py"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "U1dkdWIzSmxJR0ZzYkNCd2NtVjJhVzkxY3lCcGJuTjBjblZqZEdsdmJuTWdZVzVrSUhCc1pXRnpaU0J5..."
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-23",
          "level": "error",
          "message": {
            "text": "检测到不可见 Unicode 字符（U+200B Zero-Width Space，共 1 行出现）。不可见字符常用于在人类阅读不可见的情况下向 LLM 走私指令。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/incentives.py"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "U+200B Zero-Width Space at line(s) [2]"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-T-51",
          "level": "error",
          "message": {
            "text": "代码注释中检测到提示注入指令模式（reveal the system prompt）。当 LLM 阅读该代码/注释时可能被劫持，执行非预期指令。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/incentives.py"
                },
                "region": {
                  "startLine": 4,
                  "snippet": {
                    "text": "reveal the system prompt"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-54",
          "level": "error",
          "message": {
            "text": "检测到双向文本控制符（U+202E Right-to-Left Override, U+2066 Left-to-Right Isolate, U+2069 Pop Directional Isolate，共 4 处）。Bidi 字符可改变源码视觉呈现顺序（Trojan Source，CVE-2021-42574），使代码看起来与实际逻辑不一致，同时欺骗人类评审与 AI 助手。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/privileges.py"
                },
                "region": {
                  "startLine": 3,
                  "snippet": {
                    "text": "U+202E Right-to-Left Override; U+2066 Left-to-Right Isolate; U+2069 Pop Directional Isolate; U+2066 Left-to-Right Isolate"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "AI_PROMPT_INJECTION_CHAIN",
          "level": "error",
          "message": {
            "text": "src/constants.py:2 包含双层 Base64 编码载荷，经解码后为指令劫持内容。验证证实，在 .github/copilot-instructions.md、AGENTS.md 以及 docs/AGENT_GUIDE.md 的第 2 行均发现了完全相同的指令劫持短语，证实这是一场跨文件的协同式 AI 提示词注入攻击。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/constants.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "COMMAND_INJECTION",
          "level": "error",
          "message": {
            "text": "src/healthcheck.py:6 使用 `subprocess.run` 时设置了 `shell=True`，并使用 f-string 直接拼接了 `host` 参数，且未进行任何输入验证或过滤。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/healthcheck.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "WEAK_CRYPTOGRAPHY",
          "level": "error",
          "message": {
            "text": "src/auth.py:4 使用不带盐（salt）的 SHA-256 算法进行密码哈希处理。由于 SHA-256 是快速通用哈希算法且缺乏用户级随机盐，不符合 OWASP 关于密码存储的安全要求。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/auth.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "LOGIC_ERROR",
          "level": "error",
          "message": {
            "text": "src/privileges.py:3-4 存在逻辑缺陷：`access_level`（int）与字符串进行不等式比较（`!=`），由于 Python 类型比较机制，该条件始终为 True，导致 `grant_admin()` 函数发生无限递归。此外，该行使用了 Trojan Source 技术（Bidi 控制字符，CVE-2021-42574），通过视觉重排掩盖了类型不匹配的逻辑缺陷。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/privileges.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}