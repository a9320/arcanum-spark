{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Arcanum",
          "informationUri": "https://www.modelscope.cn/studios/Weike22/coderisk-arcanum",
          "rules": [
            {
              "id": "PIT-T-46",
              "shortDescription": {
                "text": "[PIT-T-46] Agent Instruction-File Injection"
              },
              "properties": {
                "cwe": "CWE-77",
                "severity": "critical"
              }
            },
            {
              "id": "PIT-N-06",
              "shortDescription": {
                "text": "[PIT-N-06] Document / File Upload"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-57",
              "shortDescription": {
                "text": "[PIT-E-57] Layered Encoding"
              },
              "properties": {
                "cwe": null,
                "severity": "critical"
              }
            },
            {
              "id": "PIT-E-54",
              "shortDescription": {
                "text": "[PIT-E-54] Trojan Source"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-E-23",
              "shortDescription": {
                "text": "[PIT-E-23] Invisible Text"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "PIT-T-51",
              "shortDescription": {
                "text": "[PIT-T-51] Instruction Override"
              },
              "properties": {
                "cwe": null,
                "severity": "high"
              }
            },
            {
              "id": "CROSS_FILE_PROMPT_INJECTION",
              "shortDescription": {
                "text": "Coordinated prompt injection exfiltration chain across config and agent notes"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "SQL_INJECTION",
              "shortDescription": {
                "text": "SQL injection via string concatenation in get_user"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "LOGIC_ERROR",
              "shortDescription": {
                "text": "Type confusion causes unconditional recursion in grant_admin"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            },
            {
              "id": "WEAK_CRYPTOGRAPHY",
              "shortDescription": {
                "text": "SHA-256 without salt used for password hashing"
              },
              "properties": {
                "cwe": "",
                "severity": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PIT-T-46",
          "level": "warning",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/copilot-instructions.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "Ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-T-46",
          "level": "warning",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "AGENTS.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "Ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-N-06",
          "level": "error",
          "message": {
            "text": "项目文档中检测到面向 AI Agent 的指令注入模式（ignore all previous instructions，共 1 行出现）。文档是 Agent 的常规输入，投毒不会被人类评审与传统工具注意。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "guides/AGENT_NOTES.md"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "ignore all previous instructions"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-57",
          "level": "warning",
          "message": {
            "text": "检测到2层编码（base64→base64）的提示注入载荷，用于规避基于关键词的过滤。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/config.py"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "U1dkdWIzSmxJR0ZzYkNCd2NtVjJhVzkxY3lCcGJuTjBjblZqZEdsdmJuTWdZVzVrSUdOaGJpQjViM1Vn..."
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-54",
          "level": "error",
          "message": {
            "text": "检测到双向文本控制符（U+202E Right-to-Left Override, U+2066 Left-to-Right Isolate, U+2069 Pop Directional Isolate，共 4 处）。Bidi 字符可改变源码视觉呈现顺序（Trojan Source，CVE-2021-42574），使代码看起来与实际逻辑不一致，同时欺骗人类评审与 AI 助手。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/privileges.py"
                },
                "region": {
                  "startLine": 3,
                  "snippet": {
                    "text": "U+202E Right-to-Left Override; U+2066 Left-to-Right Isolate; U+2069 Pop Directional Isolate; U+2066 Left-to-Right Isolate"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-E-23",
          "level": "error",
          "message": {
            "text": "检测到不可见 Unicode 字符（U+200B Zero-Width Space，共 1 行出现）。不可见字符常用于在人类阅读不可见的情况下向 LLM 走私指令。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/rewards.py"
                },
                "region": {
                  "startLine": 2,
                  "snippet": {
                    "text": "U+200B Zero-Width Space at line(s) [2]"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "PIT-T-51",
          "level": "error",
          "message": {
            "text": "代码注释中检测到提示注入指令模式（reveal the system prompt）。当 LLM 阅读该代码/注释时可能被劫持，执行非预期指令。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/rewards.py"
                },
                "region": {
                  "startLine": 4,
                  "snippet": {
                    "text": "reveal the system prompt"
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "CROSS_FILE_PROMPT_INJECTION",
          "level": "error",
          "message": {
            "text": "src/config.py 第2行包含两层 Base64 编码的载荷，解码后为具体的指令注入（提示词劫持）；同时在 guides/AGENT_NOTES.md、AGENTS.md 和 .github/copilot-instructions.md 中均检测到相同的提示注入模式（[QUARANTINED:potential-instruction]）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/config.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "SQL_INJECTION",
          "level": "error",
          "message": {
            "text": "src/db.py 第4行存在典型的字符串拼接 SQL 漏洞：query = \"SELECT * FROM users WHERE id = \" + uid。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/db.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "LOGIC_ERROR",
          "level": "error",
          "message": {
            "text": "src/privileges.py 中 access_level 被赋值为 int (0)，随后与字符串进行比较，在 Python 3 中 `0 != \"string\"` 恒为 True，导致无限递归；同时检测到 U+202E 等双向文本控制符（Trojan Source）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/privileges.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        },
        {
          "ruleId": "WEAK_CRYPTOGRAPHY",
          "level": "error",
          "message": {
            "text": "src/auth.py 第5行实现 `return hashlib.sha256(pw.encode()).hexdigest()`，未采用加盐及密钥拉伸（Key Stretching）机制。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/auth.py"
                },
                "region": {
                  "startLine": 0,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}