{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeRisk Cloud",
          "version": "2.0.0",
          "informationUri": "https://github.com/a9320/coderisk-cloud",
          "rules": [
            {
              "id": "PIT-T-46",
              "name": "Agent Instruction-File Injection",
              "shortDescription": {
                "text": "[PIT-T-46] Agent Instruction-File Injection"
              },
              "fullDescription": {
                "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-T-46, https://nvd.nist.gov/vuln/detail/CVE-2025-53773, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-T-46\n- https://nvd.nist.gov/vuln/detail/CVE-2025-53773\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-T-46",
                  "name": "Agent Instruction-File Injection",
                  "pillar": "technique",
                  "aliases": [
                    "Cursor Rules Backdoor",
                    "Copilot Instructions Hijack",
                    "AI Config Injection",
                    "CLAUDE.md Backdoor"
                  ],
                  "cwe": "CWE-77",
                  "mitre_atlas": "AML.T0051.001",
                  "cve": "CVE-2025-53773",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-T-46",
                    "https://nvd.nist.gov/vuln/detail/CVE-2025-53773",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            },
            {
              "id": "PIT-N-06",
              "name": "Document / File Upload",
              "shortDescription": {
                "text": "[PIT-N-06] Document / File Upload"
              },
              "fullDescription": {
                "text": "项目文档中检测到面向 AI Agent 的指令注入模式（ignore all previous instructions，共 1 行出现）。文档是 Agent 的常规输入，投毒不会被人类评审与传统工具注意。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-N-06, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-N-06\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-N-06",
                  "name": "Document / File Upload",
                  "pillar": "input",
                  "aliases": [
                    "README Poisoning",
                    "Docs Prompt Injection"
                  ],
                  "mitre_atlas": "AML.T0051.001",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-N-06",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            },
            {
              "id": "PIT-E-54",
              "name": "Trojan Source",
              "shortDescription": {
                "text": "[PIT-E-54] Trojan Source"
              },
              "fullDescription": {
                "text": "检测到双向文本控制符（U+202E Right-to-Left Override, U+2066 Left-to-Right Isolate, U+2069 Pop Directional Isolate，共 4 处）。Bidi 字符可改变源码视觉呈现顺序（Trojan Source，CVE-2021-42574），使代码看起来与实际逻辑不一致，同时欺骗人类评审与 AI 助手。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-E-54, https://trojansource.codes/, https://nvd.nist.gov/vuln/detail/CVE-2021-42574, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-E-54\n- https://trojansource.codes/\n- https://nvd.nist.gov/vuln/detail/CVE-2021-42574\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-E-54",
                  "name": "Trojan Source",
                  "pillar": "evasion",
                  "aliases": [
                    "Bidi Override",
                    "Source Code Visual Spoofing"
                  ],
                  "cve": "CVE-2021-42574",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-E-54",
                    "https://trojansource.codes/",
                    "https://nvd.nist.gov/vuln/detail/CVE-2021-42574",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            },
            {
              "id": "PIT-E-57",
              "name": "Layered Encoding",
              "shortDescription": {
                "text": "[PIT-E-57] Layered Encoding"
              },
              "fullDescription": {
                "text": "检测到2层编码（base64→base64）的提示注入载荷，用于规避基于关键词的过滤。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-E-57, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-E-57\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-E-57",
                  "name": "Layered Encoding",
                  "pillar": "evasion",
                  "aliases": [
                    "Multi-layer Encoding",
                    "Base64+ROT13 Chaining"
                  ],
                  "mitre_atlas": "AML.T0051.001",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-E-57",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            },
            {
              "id": "PIT-E-23",
              "name": "Invisible Text",
              "shortDescription": {
                "text": "[PIT-E-23] Invisible Text"
              },
              "fullDescription": {
                "text": "检测到不可见 Unicode 字符（U+200B Zero-Width Space，共 1 行出现）。不可见字符常用于在人类阅读不可见的情况下向 LLM 走私指令。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-E-23, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-E-23\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-E-23",
                  "name": "Invisible Text",
                  "pillar": "evasion",
                  "aliases": [
                    "ASCII Smuggling",
                    "Invisible Unicode",
                    "Zero-Width Characters",
                    "Unicode Tag Injection",
                    "Hidden Instruction Characters"
                  ],
                  "mitre_atlas": "AML.T0051.001",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-E-23",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            },
            {
              "id": "PIT-T-51",
              "name": "Instruction Override",
              "shortDescription": {
                "text": "[PIT-T-51] Instruction Override"
              },
              "fullDescription": {
                "text": "代码注释中检测到提示注入指令模式（reveal the system prompt）。当 LLM 阅读该代码/注释时可能被劫持，执行非预期指令。"
              },
              "help": {
                "text": "References: https://arcanum-sec.com/pitax#PIT-T-51, https://github.com/Arcanum-Sec/arc_pi_taxonomy",
                "markdown": "- https://arcanum-sec.com/pitax#PIT-T-51\n- https://github.com/Arcanum-Sec/arc_pi_taxonomy"
              },
              "properties": {
                "pitax": {
                  "code": "PIT-T-51",
                  "name": "Instruction Override",
                  "pillar": "technique",
                  "aliases": [
                    "Comment Prompt Injection",
                    "Indirect Prompt Injection"
                  ],
                  "mitre_atlas": "AML.T0051.001",
                  "references": [
                    "https://arcanum-sec.com/pitax#PIT-T-51",
                    "https://github.com/Arcanum-Sec/arc_pi_taxonomy"
                  ]
                }
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PIT-T-46",
          "level": "error",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Ignore all previous instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".cursor\\rules"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "properties": {
            "pitax": {
              "confidence": "90",
              "evidence": "Ignore all previous instructions"
            }
          }
        },
        {
          "ruleId": "PIT-T-46",
          "level": "error",
          "message": {
            "text": "AI 指令文件中检测到指令覆盖/角色劫持模式（Override instructions，共 1 行出现）。攻击者可能在仓库的 AI 助手配置中植入后门（同 CVE-2025-53773 攻击模式）。"
