# CodeRisk Cloud 环境变量（必填项）
CODERISK_API_KEY=your-secret-api-key-here

# Redis（Celery Broker + Backend）
REDIS_URL=redis://localhost:6379/0

# CodeRisk Agent（引擎层）路径，不填则自动探测
# CODERISK_PATH=/app/code-risk-agent

# Nutrient DWS（PDF 签名，可选）
# NUTRIENT_DWS_API_KEY=
# NUTRIENT_DWS_API_URL=https://api.nutrient.io/build

# GitHub Webhook（可选）
# GITHUB_WEBHOOK_SECRET=

# Worker 并发数
WORKER_CONCURRENCY=2

# 报告输出目录
REPORTS_DIR=./reports

# ── 主线 A：系统提示金库（可选）──
# 方式 1：JSON 数组（多条系统提示）
# CODERISK_SYSTEM_PROMPTS='["You are the CodeRisk static analysis agent...", "Second prompt..."]'
# 方式 2：单条系统提示
# CODERISK_SYSTEM_PROMPT="You are the CodeRisk static analysis agent..."
# 方式 3：外部文件路径（UTF-8）
# CODERISK_SYSTEM_PROMPT_FILE=/path/to/prompts.txt